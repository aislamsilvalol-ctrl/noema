# ─── Mode ─────────────────────────────────────────────────────────────────────
# cloud → hosted AI providers allowed
# local → only on-device models; outbound egress blocked; telemetry removed
NOEMA_MODE=cloud
NOEMA_ENV=development
NOEMA_LOG_LEVEL=info

# ─── Data ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://noema:noema@postgres:5432/noema
REDIS_URL=redis://redis:6379/0

# Object storage. Leave S3 vars empty to use the local filesystem driver.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/lib/noema/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# NEVER use this placeholder in a real deployment.
NOEMA_MASTER_KEY=CHANGE_ME_base64_32_bytes
NOEMA_SESSION_SECRET=CHANGE_ME_base64_32_bytes
NOEMA_SECURE_COOKIES=false          # true behind TLS
NOEMA_ALLOW_SIGNUPS=true            # false for single-user installs
NOEMA_CORS_ORIGINS=http://localhost:3000

# ─── AI providers ─────────────────────────────────────────────────────────────
# Deployment default. Users may override per workspace or notebook, and BYOK keys
# supplied through the UI take precedence over anything set here.
NOEMA_DEFAULT_PROVIDER=ollama

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Task-class model routing (leave empty to use each provider's default)
NOEMA_MODEL_TUTOR=
NOEMA_MODEL_EXTRACT=
NOEMA_MODEL_GRADE=
NOEMA_MODEL_SUMMARIZE=

# Embeddings are pinned per deployment. Changing this triggers a re-embed migration.
NOEMA_EMBEDDING_PROVIDER=ollama
NOEMA_EMBEDDING_MODEL=nomic-embed-text
NOEMA_EMBEDDING_DIM=768

# ─── Limits ───────────────────────────────────────────────────────────────────
NOEMA_MAX_UPLOAD_MB=100
NOEMA_USER_STORAGE_QUOTA_MB=2048
NOEMA_RATE_LIMIT_PER_MINUTE=120
NOEMA_AI_DAILY_TOKEN_BUDGET=1000000   # per user; degrades gracefully on breach

# ─── Learning engine ──────────────────────────────────────────────────────────
NOEMA_FSRS_TARGET_RETENTION=0.90
NOEMA_FSRS_OPTIMIZE_MIN_REVIEWS=400
NOEMA_MASTERY_MODEL_VERSION=1

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
